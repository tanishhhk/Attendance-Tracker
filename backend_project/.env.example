# Local development defaults. Copy this file to .env if using python-dotenv.
# Production must set DJANGO_DEBUG=false, DJANGO_SECRET_KEY, and allowed hosts.
DJANGO_DEBUG=true
# In development this can be omitted; a random temporary key is generated.
# DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
DJANGO_SECURE_SSL_REDIRECT=false
